generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Message {
  messageId String   @id @db.VarChar(128)
  storeId   String   @db.VarChar(64)
  phone     String   @db.VarChar(20)
  text      String   @db.Text
  timestamp DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, timestamp])
  @@map("messages")
}
